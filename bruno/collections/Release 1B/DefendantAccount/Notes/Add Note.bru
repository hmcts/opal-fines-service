meta {
  name: Add Note
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/notes/add
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Business-Unit-Id: 77
  If-Match: "{{legacyOnlyAccountVersion}}"
}

body:json {
  {
    "activity_note": {
      "record_type": "defendant_accounts",
      "record_id": "770000004141",
      "note_text": "PO-10341 manual test note",
      "note_type": "AA"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
