meta {
  name: Party
  seq: 4
}

auth {
  mode: inherit
}

script:pre-request {
  const orgRequests = new Set([
    "Add-Party-Org",
    "Add-Party-Org-No-Debtor",
    "Get-Party-Org",
    "Remove-Party"
  ]);
  const accountIdVariable = orgRequests.has(req.getName())
    ? "defendantAccount_idOrg"
    : "defendantAccount_id";
  const id = bru.getEnvVar(accountIdVariable);
  const baseUrl = bru.getEnvVar("baseURL");
  const token = bru.getVar("BEARER_TOKEN") || bru.getEnvVar("BEARER_TOKEN");
  const url = `${baseUrl}/defendant-accounts/${id}/history`

  const response = await bru.sendRequest({
    method: "GET",
    url: url,
    headers: {
      Authorization: `Bearer ${token}`
    }
  });

  if (response.status !== 200) {
    throw new Error(`Could not retrieve the current defendant account ETag: HTTP ${response.status}`);
  }

  const etag = response.headers?.etag || response.headers?.ETag || response.getHeader?.("ETag");
  if (!etag) {
    throw new Error("The defendant account response did not include an ETag");
  }

  req.setHeader("If-Match", etag);
}
