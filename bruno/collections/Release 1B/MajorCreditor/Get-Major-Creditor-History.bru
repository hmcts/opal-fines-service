meta {
  name: Get-Major-Creditor-History
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/major-creditor-accounts/99000000000850/history
  body: none
  auth: bearer
}

params:query {
  dateFrom: 2026-06-01
  dateTo: 2026-06-30
