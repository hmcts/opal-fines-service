{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_jobs"],
  "properties": {
    "interface_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interface_job_id", "business_unit_id", "override_inhibits"],
        "properties": {
          "interface_job_id": {
            "type": "integer",
            "format": "int64"
          },
          "business_unit_id": {
            "type": "integer",
            "format": "int16"
          },
          "override_inhibits": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
