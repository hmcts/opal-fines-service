{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opal-fines-service/getProsecutorsRefDataResponse.json",
  "type": ["object", "null"],
  "properties": {
    "count": {
      "type": ["integer", "null"],
      "description": "The count of prosecutors returned in this response"
    },
    "ref_data": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/prosecutor"
      }
    }
  },
  "$defs": {
    "prosecutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prosecutor_id": {
          "type": ["integer", "null"],
          "format": "int64",
          "description": "Legacy prosecutor identifier"
        },
        "name": {
          "type": "string",
          "description": "The name of the prosecutor"
        },
        "prosecutor_code": {
          "type": ["integer", "null"],
          "format": "int16",
          "description": "The Opal prosecutor code"
        },
        "address_line_1": {
          "type": ["string", "null"],
          "maxLength": 60,
          "description": "The first line of the address of the prosecutor"
        },
        "address_line_2": {
          "type": ["string", "null"],
          "description": "The second line of the address of the prosecutor"
        },
        "address_line_3": {
          "type": ["string", "null"],
          "description": "The third line of the address of the prosecutor"
        },
        "address_line_4": {
          "type": ["string", "null"],
          "description": "The fourth line of the address of the prosecutor"
        },
        "address_line_5": {
          "type": ["string", "null"],
          "description": "The fifth line of the address of the prosecutor"
        },
        "postcode": {
          "type": ["string", "null"],
          "description": "The postcode of the prosecutor"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "The date up until which the prosecutor is active"
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
