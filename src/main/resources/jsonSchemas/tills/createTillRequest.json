{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Add Till Request",
  "$comment": "Keep aligned with the POST /tills request schema in src/main/resources/openapi/Tills.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_unit_id",
    "payments_in"
  ],
  "properties": {
    "business_unit_id": {
      "$ref": "#/$defs/BusinessUnitIdTypes"
    },
    "payments_in": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TillsCreatePaymentIn"
      }
    }
  },
  "$defs": {
    "BusinessUnitIdTypes": {
      "type": "integer",
      "format": "int16",
      "description": "Business unit identifier"
    },
    "TillsCreatePaymentIn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_details",
        "additional_information"
      ],
      "properties": {
        "defendant_account_id": {
          "$ref": "#/$defs/BigIntTypes",
          "description": "Required only for F; must identify an existing defendant account in the submitted business unit."
        },
        "payment_details": {
          "$ref": "#/$defs/TillsCreatePaymentDetails"
        },
        "additional_information": {
          "$ref": "#/$defs/TillsCreateAdditionalInformation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "payment_details": {
                "properties": {
                  "destination_type": {
                    "const": "F"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "defendant_account_id"
            ],
            "properties": {
              "additional_information": {
                "properties": {
                  "payment_received_from": {
                    "enum": [
                      "D",
                      "T"
                    ]
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "payer_type"
                      ]
                    },
                    {
                      "required": [
                        "payer_details"
                      ]
                    },
                    {
                      "required": [
                        "court_fee_code"
                      ]
                    },
                    {
                      "required": [
                        "number_of_items"
                      ]
                    },
                    {
                      "required": [
                        "suspense_reason_code"
                      ]
                    },
                    {
                      "required": [
                        "suspense_reason_detail"
                      ]
                    },
                    {
                      "required": [
                        "suspense_note"
                      ]
                    }
                  ]
                },
                "if": {
                  "properties": {
                    "payment_received_from": {
                      "const": "T"
                    }
                  }
                },
                "then": {
                  "required": [
                    "third_party_payer_name"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payment_details": {
                "properties": {
                  "destination_type": {
                    "const": "C"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "defendant_account_id"
              ]
            },
            "properties": {
              "additional_information": {
                "required": [
                  "court_fee_code",
                  "number_of_items",
                  "suspense_note",
                  "payer_type",
                  "payer_details"
                ],
                "properties": {
                  "payment_received_from": {
                    "enum": [
                      "A",
                      "T"
                    ]
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "suspense_reason_code"
                      ]
                    },
                    {
                      "required": [
                        "suspense_reason_detail"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payment_details": {
                "properties": {
                  "destination_type": {
                    "const": "S"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "defendant_account_id"
              ]
            },
            "properties": {
              "additional_information": {
                "required": [
                  "suspense_reason_code",
                  "suspense_note"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "court_fee_code"
                      ]
                    },
                    {
                      "required": [
                        "number_of_items"
                      ]
                    }
                  ]
                },
                "if": {
                  "properties": {
                    "suspense_reason_code": {
                      "enum": [
                        "OF",
                        "FA",
                        "MS"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "payer_type",
                    "payer_details"
                  ],
                  "not": {
                    "required": [
                      "suspense_reason_detail"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payment_details": {
                "properties": {
                  "method": {
                    "const": "CT"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "additional_information": {
                "required": [
                  "transfer_source"
                ]
              }
            }
          }
        }
      ]
    },
    "BigIntTypes": {
      "type": "integer",
      "format": "int64"
    },
    "TillsCreatePaymentDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "method",
        "destination_type",
        "allocation_type"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "multipleOf": 0.01,
          "description": "DB Mapping - payments_in.payment_amount"
        },
        "method": {
          "type": "string",
          "enum": [
            "NC",
            "CQ",
            "CT",
            "PO"
          ],
          "description": "Coded payment method returned by Get Mappings."
        },
        "destination_type": {
          "type": "string",
          "enum": [
            "F",
            "S",
            "C"
          ],
          "description": "Fines (F), Suspense (S) or Court Fee (C)."
        },
        "allocation_type": {
          "type": "string",
          "description": "Coded allocation category returned by Get Mappings."
        }
      }
    },
    "TillsCreateAdditionalInformation": {
      "description": "Per-payment allocation metadata and conditional payer input. Only payment_received_from is globally required.\nPayer type, name and address are mapped to the durable Party and excluded from Payment In additional_information.\nCourt Fee and Suspense fields remain available to allocation.\n",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_received_from"
      ],
      "properties": {
        "payment_received_from": {
          "type": "string",
          "enum": [
            "D",
            "A",
            "T"
          ],
          "description": "F permits D or T; C permits A or T; S permits D, A or T.\nRetained in Payment In metadata for allocation.\n"
        },
        "third_party_payer_name": {
          "type": "string",
          "description": "Required for F received from T, without structured payer data.\nStored in payments_in.third_party_payer_name for allocation.\n",
          "minLength": 1,
          "maxLength": 30
        },
        "court_fee_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "number_of_items": {
          "type": "integer",
          "format": "int16",
          "minimum": 1
        },
        "payment_reference": {
          "type": "string",
          "description": "Optional for every method. Supplied values are retained in Payment In metadata for allocation.\n"
        },
        "transfer_source": {
          "type": "string",
          "enum": [
            "NATWEST",
            "ALLPAY",
            "BARCLAYCARD",
            "BTECKOH",
            "OTHER",
            "DWP",
            "CDER",
            "JACOBS",
            "MARSTON"
          ],
          "description": "Required for CT and optional for other methods.\nSupplied values are retained in Payment In metadata for allocation.\n"
        },
        "suspense_reason_code": {
          "type": "string",
          "enum": [
            "OF",
            "FA",
            "MS",
            "UN"
          ]
        },
        "suspense_reason_detail": {
          "type": "string"
        },
        "suspense_note": {
          "type": "string",
          "minLength": 1
        },
        "payer_type": {
          "$ref": "#/$defs/TillsCreatePayerType",
          "description": "Required for C and S/OF, FA, MS; optional for S/UN; prohibited for F.\nUsed to populate parties.organisation through the associated Miscellaneous Account.\n"
        },
        "payer_details": {
          "$ref": "#/$defs/TillsCreatePayerDetails",
          "description": "Required whenever payer_type is supplied; must contain only the matching name structure.\nName fields and addresses remain optional. Persisted in Party, excluded from Payment In metadata.\n"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "payer_type": {
                "const": "Individual"
              }
            },
            "required": [
              "payer_type"
            ]
          },
          "then": {
            "required": [
              "payer_details"
            ],
            "properties": {
              "payer_details": {
                "required": [
                  "individual"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "payer_type": {
                "const": "Organisation"
              }
            },
            "required": [
              "payer_type"
            ]
          },
          "then": {
            "required": [
              "payer_details"
            ],
            "properties": {
              "payer_details": {
                "required": [
                  "organisation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "payer_details"
            ]
          },
          "then": {
            "required": [
              "payer_type"
            ]
          }
        }
      ]
    },
    "TillsCreatePayerType": {
      "type": "string",
      "enum": [
        "Individual",
        "Organisation"
      ]
    },
    "TillsCreatePayerDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address_line_1": {
          "type": "string",
          "maxLength": 35
        },
        "address_line_2": {
          "type": "string",
          "maxLength": 35
        },
        "address_line_3": {
          "type": "string",
          "maxLength": 35
        },
        "postcode": {
          "type": "string",
          "maxLength": 10
        },
        "individual": {
          "$ref": "#/$defs/TillsCreateIndividualPayer"
        },
        "organisation": {
          "$ref": "#/$defs/TillsCreateOrganisationPayer"
        }
      },
      "oneOf": [
        {
          "required": [
            "individual"
          ]
        },
        {
          "required": [
            "organisation"
          ]
        }
      ]
    },
    "TillsCreateIndividualPayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 20
        },
        "forenames": {
          "type": "string",
          "maxLength": 50
        },
        "surname": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "TillsCreateOrganisationPayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organisation_name": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
