{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "published-reference-data-message.schema.json",
  "title": "Published Reference Data Message",
  "description": "Common schema for published Reference Data messages including Offence and LJA data products.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "messageType": {
          "type": "string",
          "const": "ReferenceData"
        },
        "dataProduct": {
          "type": "string",
          "enum": [
            "Offence",
            "LJA"
          ]
        },
        "operation": {
          "type": "string",
          "const": "PUBLISH"
        },
        "sourceSystem": {
          "type": "string",
          "const": "Semarchy"
        },
        "createdDateTime": {
          "type": "string",
          "format": "date-time"
        },
        "ReleasePackageId": {
          "type": "integer"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "messageId",
        "messageType",
        "dataProduct",
        "operation",
        "sourceSystem",
        "createdDateTime",
        "ReleasePackageId",
        "recordCount"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "records"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "header",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "header": {
            "properties": {
              "dataProduct": {
                "const": "Offence"
              }
            },
            "required": [
              "dataProduct"
            ]
          }
        },
        "required": [
          "header"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "records": {
                "items": {
                  "$ref": "#/$defs/offenceRecord"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "header": {
            "properties": {
              "dataProduct": {
                "const": "LJA"
              }
            },
            "required": [
              "dataProduct"
            ]
          }
        },
        "required": [
          "header"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "records": {
                "items": {
                  "$ref": "#/$defs/ljaRecord"
                }
              }
            }
          }
        }
      }
    }
  ],
