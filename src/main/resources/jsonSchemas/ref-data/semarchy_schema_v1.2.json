{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "published-reference-data-message.schema.json",
  "title": "Published Reference Data Message",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "const": "ReferenceData"
        },
        "data_product": {
          "type": "string",
          "enum": [
            "Offence",
            "Court",
            "LJA"
          ]
        },
        "operation": {
          "const": "PUBLISH"
        },
        "source_system": {
          "const": "Semarchy"
        },
        "created_date_time": {
          "type": "string",
          "format": "date-time"
        },
        "release_package_id": {
          "type": "integer"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "message_id",
        "message_type",
        "data_product",
        "operation",
        "source_system",
        "created_date_time",
        "release_package_id",
        "record_count"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "records"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "header",
    "payload"
  ],
  "oneOf": [
    {
      "title": "Offence message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Offence"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/offenceRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "Court message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "Court"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/courtRecord"
              }
            }
          }
        }
      }
    },
    {
      "title": "LJA message",
      "properties": {
        "header": {
          "properties": {
            "data_product": {
              "const": "LJA"
            }
          }
        },
        "payload": {
          "properties": {
            "records": {
              "items": {
                "$ref": "#/$defs/ljaRecord"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
