        },
        "addresses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "contact_information": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/contactInformation"
          }
        }
      },
      "required": [
        "lja_name",
        "lja_type",
        "start_date",
        "addresses",
        "contact_information"
