        "cluster_information_code": {
          "type": "integer"
        },
        "enforcement_area_code": {
          "type": "integer"
        },
        "region_code": {
          "type": "integer"
        },
        "related_lja_code": {
          "type": "integer"
        },
        "addresses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "contact_information": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/contactInformation"
          }
        }
      },
      "required": [
        "court_name",
        "court_type",
        "start_date",
        "addresses",
        "contact_information"
      ],
      "additionalProperties": false
    },
    "ljaRecord": {
