          "maxLength": 100
        },
        "court_type": {
          "type": "string",
          "maxLength": 6
        },
        "court_welsh_name": {
          "type": "string",
          "maxLength": 100
        },
        "default_duration": {
          "type": "string",
          "maxLength": 10
        },
        "default_start_time": {
          "type": "string",
          "maxLength": 10
        },
        "division_code": {
          "type": "string",
          "maxLength": 20
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
