        {
          "name": "CJSCodeUniqueKey",
          "key": [
            "cjs_code"
          ]
        }
      ],
      "allOf": [
        {
          "$comment": "Offence:OffenceRevision.CivilAppDataMandatoryFieldValidation",
          "if": {
            "properties": {
              "offence_source": {
                "const": "APPS"
              }
            },
            "required": [
              "offence_source"
            ]
          },
          "then": {
            "required": [
              "jurisdiction",
              "hearing_code",
              "link_type",
              "active_offence_order",
              "summons_template_type",
              "breach_type"
            ],
            "properties": {
              "jurisdiction": {
                "not": {
                  "type": "null"
                }
              },
              "hearing_code": {
                "not": {
                  "type": "null"
                }
              },
              "link_type": {
                "not": {
                  "type": "null"
                }
              },
              "active_offence_order": {
                "not": {
                  "type": "null"
                }
              },
              "summons_template_type": {
                "not": {
                  "type": "null"
                }
              },
              "breach_type": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "x-rules": [
