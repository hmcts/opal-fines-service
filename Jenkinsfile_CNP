}

def secrets = [
  'opal-${env}': [
    secret('bais-private-key', 'FUNCTIONAL_TEST_SFTP_PRIVATE_KEY')
  ]
]

def stagingFunctionalTestSecrets = [
  'opal-${env}': [
    secret('fines-service-POSTGRES-HOST', 'OPAL_FINES_DB_HOST'),
    secret('fines-service-POSTGRES-PORT', 'OPAL_FINES_DB_PORT'),
    secret('fines-service-POSTGRES-DATABASE', 'OPAL_FINES_DB_NAME'),
    secret('fines-service-POSTGRES-USER', 'OPAL_FINES_DB_USERNAME'),
    secret('fines-service-POSTGRES-PASS', 'OPAL_FINES_DB_PASSWORD')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   version    : '',
   envVariable: envVar]
}

withPipeline(type, product, component) {
  enableDbMigration(product)
  onPR {
    loadVaultSecrets(secrets)
  }
  onMaster {
    loadVaultSecrets(stagingFunctionalTestSecrets)
  }

  env.FAIL_FAST = false
  env.EXTENDED_TESTS = "false"
  env.STAGING_DB_SCHEMA = 'public'
  env.OPAL_LEGACY_GATEWAY_URL = 'https://opal-legacy-db-stub-staging.platform.hmcts.net/opal'
  env.OPAL_LEGACY_STUB_IMAGE = 'hmctsprod.azurecr.io/opal/legacy-db-stub:latest'
  env.OPAL_LOGGING_SERVICE_API_URL = 'https://opal-logging-service.staging.platform.hmcts.net'
  if (!env.OPAL_USER_SERVICE_API_URL && !env.CHANGE_ID) {
    env.OPAL_USER_SERVICE_API_URL = 'https://opal-user-service.staging.platform.hmcts.net'
  }

  // master fails we want a notification on slack
  onMaster {
    enableSlackNotifications('#opal-builds')
  }


  before('akschartsinstall') {
    onPR {
      determineDevEnvironmentDeployment()
    }
  }

  before('test') {
    onPR {
      enableExtendedTestsForLabel()
    }
  }

  afterSuccess('akschartsinstall') {
    onPR {
      configureFunctionalTestDatabase(
        devValuesFile, "opal-${component}-pr-${env.CHANGE_ID}", product
      )
    }
  }

  before('functionalTest:dev') {
    onPR {
      withAksClient('dev', 'dev', product) {
        def kubectl = new Kubectl(this, 'dev', product)
        kubectl.login()
        configureFunctionalTestDatabase(
          devValuesFile, "opal-${component}-pr-${env.CHANGE_ID}", product
        )
        steps.sh(
          script: "kubectl --namespace '${product}' port-forward "
            + "pod/opal-${component}-pr-${env.CHANGE_ID}-postgresql-0 15432:5432 "
            + "> .functional-test-db-port-forward.log 2>&1 & "
            + "echo \$! > .functional-test-db-port-forward.pid && sleep 2"
        )
        env.FUNCTIONAL_TEST_DB_URL = "jdbc:postgresql://127.0.0.1:15432/" +
          env.OPAL_FINES_DB_NAME + (env.OPAL_FINES_DB_OPTIONS ?: '')
      }
    }
  }

  before('functionalTest:stg') {
    onMaster {
      if (!env.OPAL_FINES_DB_HOST?.trim() || !env.OPAL_FINES_DB_PORT?.trim()
        || !env.OPAL_FINES_DB_NAME?.trim() || !env.OPAL_FINES_DB_USERNAME?.trim()
        || !env.OPAL_FINES_DB_PASSWORD?.trim()) {
        throw new RuntimeException('Missing staging functional-test fines database credentials')
      }
    }
  }

  afterAlways('functionalTest:dev') {
    onPR {
      steps.sh(
        script: "if [ -f .functional-test-db-port-forward.pid ]; then "
          + "kill \$(cat .functional-test-db-port-forward.pid) 2>/dev/null || true; "
          + "rm -f .functional-test-db-port-forward.pid; fi",
        returnStatus: true
      )
      env.FUNCTIONAL_TEST_DB_URL = ''
    }
  }

  afterAlways('test') {
    publishIntegrationResults()

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "build/reports/checkstyle",
        reportFiles          : "main.html",
        reportName           : "Checkstyle Main Report"
    ]

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "build/reports/checkstyle",
        reportFiles          : "test.html",
        reportName           : "Checkstyle Test Report"
    ]

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "build/reports/checkstyle",
        reportFiles          : "functionalTest.html",
        reportName           : "Checkstyle Functional Test Report"
    ]

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "build/reports/checkstyle",
        reportFiles          : "integrationTest.html",
        reportName           : "Checkstyle Integration Test Report"
    ]

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "build/reports/tests/test",
        reportFiles          : "index.html",
        reportName           : "Unit Tests Report"
    ]

    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : "integration-output/report",
        reportFiles          : "index.html",
        reportName           : "Integration Tests Report"
    ]
  }

  afterAlways('functionalTest:dev') {
    publishFunctionalResults()
  }

  afterAlways('smoketest:dev') {
    publishSmokeResults()
  }

  afterAlways('functionalTest:stg') {
    publishFunctionalResults()
  }
  afterAlways('smoketest:stg') {
    publishSmokeResults()
  }
}
